ANTHROPIC_API_KEY=sk-...
ASSEMBLYAI_API_KEY=...
CARTESIA_API_KEY=...
# Cartesia voice for the sandwich and ollama pipelines. Leave empty for the default voice.
# Paste the ID of your cloned voice or a voice from the Cartesia library.
CARTESIA_VOICE_ID=
# Local voice service for voices recorded on the desk (make dev-py starts it)
LOCAL_VOICE_URL=http://127.0.0.1:8001
# Speech to text in the voice service, for the ollama pipeline.
# mlx-community/whisper-large-v3-turbo also works (slower).
LOCAL_STT_MODEL=mlx-community/parakeet-tdt-0.6b-v3
# Silence (ms) before the ollama pipeline treats the customer's turn as finished
LOCAL_STT_SILENCE_MS=600
# Gemini API key. Set it on the desk (Settings → Gemini) instead; the first
# start copies a key from here to the desk.
GOOGLE_API_KEY=
# Python backend only:
# - "realtime": Gemini Live speech-to-speech (default)
# - "sandwich": AssemblyAI STT → LLM_PROVIDER agent → Cartesia TTS
# - "ollama": voice to voice around a local Ollama model in a harness, with
#   barge-in. STT and TTS run on this Mac when the voice service runs (else
#   AssemblyAI and Cartesia).
PIPELINE=realtime

# LLM for the sandwich pipeline: "anthropic" or "ollama" (local).
# The ollama pipeline also uses OLLAMA_MODEL and OLLAMA_BASE_URL.
LLM_PROVIDER=anthropic
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434

# Gemini Live voice activity detection (realtime pipeline)
# Silence (ms) before Gemini treats the user's turn as finished
GEMINI_VAD_SILENCE_MS=700
GEMINI_VAD_PREFIX_PADDING_MS=200
# Seconds of silence after the agent speaks before it asks "Hello, are you there?"
GEMINI_IDLE_SECONDS=8

# AssemblyAI turn detection (sandwich and ollama pipelines). Lower silence
# values reply sooner but may cut the customer off mid-sentence.
ASSEMBLYAI_END_OF_TURN_CONFIDENCE=0.4
ASSEMBLYAI_MIN_TURN_SILENCE_MS=300
ASSEMBLYAI_MAX_TURN_SILENCE_MS=1000
